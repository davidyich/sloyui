{
  "$extensions": {
    "com.sloyui.export": {
      "version": "0.19.11",
      "collection": "Sloy UI · Borders",
      "mode": "Off"
    }
  },
  "border": {
    "width": {
      "$type": "number",
      "$value": 0,
      "$extensions": {
        "com.sloyui.variable": {
          "scopes": [],
          "visibility": "internal",
          "codeSyntax": {
            "WEB": "var(--cap-decoration-width)"
          }
        },
        "com.figma.aliasData": {
          "targetVariableSetName": "Sloy UI · Semantic",
          "targetVariableName": "border/none"
        }
      },
      "$description": "Независимая декоративная граница; не влияет на focus или структурные разделители."
    }
  }
}
